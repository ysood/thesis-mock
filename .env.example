# Copy to .env and fill in. MODEL is "provider:model" for LangChain's init_chat_model.
MODEL=openai:gpt-5.6-luna
OPENAI_API_KEY=

# Optional
# REASONING_EFFORT=high     # OpenAI: none, low, medium, high (prototype default), xhigh, max
# MAX_TOKENS=16000
# TEMPERATURE=              # leave unset: reasoning models reject sampling parameters

# Alternative: MODEL=anthropic:claude-opus-5-5 with ANTHROPIC_API_KEY=
